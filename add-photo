#!/usr/bin/env bash

# exit on error
set -e

if [ -z "$1" ]; then
    echo "./add-photo <path_to_photo>"
    exit 1
fi

PHOTO_PATH="$1"

if [ ! -f "$PHOTO_PATH" ]; then
    echo "not found: $PHOTO_PATH"
    exit 1
fi

echo "----------------------------------------"
echo "adding new photo to lens"
echo "file: $PHOTO_PATH"
echo "----------------------------------------"

read -p "caption / desc: " CAPTION
if [ -z "$CAPTION" ]; then
    echo "caption is needed"
    exit 1
fi

read -p "pin? [y/N]: " PIN_PROMPT
PINNED="false"
if [[ "$PIN_PROMPT" =~ ^[Yy]$ ]]; then
    PINNED="true"
fi

FILENAME=$(basename "$PHOTO_PATH")
if [[ "$FILENAME" =~ ([0-9]{4})([0-9]{2})([0-9]{2}) ]]; then
    YYYY="${BASH_REMATCH[1]}"
    MM="${BASH_REMATCH[2]}"
    DD="${BASH_REMATCH[3]}"
    
    MONTHS=("" "Jan" "Feb" "Mar" "Apr" "May" "Jun" "Jul" "Aug" "Sep" "Oct" "Nov" "Dec")
    MONTH_IDX=$((10#$MM))
    DAY_NUM=$((10#$DD))
    
    if [ $MONTH_IDX -ge 1 ] && [ $MONTH_IDX -le 12 ]; then
        DETECTED_DATE="${MONTHS[$MONTH_IDX]} $DAY_NUM, $YYYY"
    fi
fi

if [ -n "$DETECTED_DATE" ]; then
    read -p "detected date '$DETECTED_DATE'. is this correct? [Y/n]: " DATE_CORRECT
    if [[ "$DATE_CORRECT" =~ ^[Nn]$ ]]; then
        read -p "enter date (e.g., Jul 7, 2026): " FINAL_DATE
    else
        FINAL_DATE="$DETECTED_DATE"
    fi
else
    read -p "enter date (e.g., Jul 7, 2026): " FINAL_DATE
fi

echo "optimizing, converting to WebP, and updating LensPage..."
npx tsx scripts/add-photo.ts "$PHOTO_PATH" "$CAPTION" "$PINNED" "$FINAL_DATE"

echo "done, photo added."
