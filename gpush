#!/bin/bash

force=false
if [ "$1" == "-f" ]; then
    force=true
fi

curr=$(git rev-parse --abbrev-ref HEAD)

if [ "$force" = true ]; then
    echo "forcing push to $curr..."
    git push origin "$curr" --force
    exit 0
fi

if [ -z "$(git status --porcelain)" ]; then
    echo "nothing to commit lol"
    exit 0
fi

echo "--- current changes ---"
git diff --stat
git add .

read -p "title: " title
read -p "desc: " desc

# don't let it commit absolute void
if [ -z "$title" ]; then
    echo "need a title dude"
    git restore --staged .
    exit 1
fi

if [ -z "$desc" ]; then
    git commit -m "$title"
else
    git commit -m "$title" -m "$desc"
fi

echo -e "\n--- ready to push to $curr? ---"
git log -1 --stat
read -p "confirm push? [y/N]: " confirm

if [[ "$confirm" =~ ^[Yy]$ ]]; then
    git push origin "$curr"
    echo "pushed."
else
    echo "aborting push. rolling back commit but keeping your changes..."
    git reset --soft HEAD~1
fi
